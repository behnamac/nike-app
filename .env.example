# Copy to .env.local and fill in values.
# drizzle.config.ts and scripts/ load .env.local explicitly.

# --- Database (Neon Postgres) ---
# Without it the app falls back to mock products and an in-memory cart.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Trusted origin for auth and base URL for password-reset links
NEXTAUTH_URL=http://localhost:3000

# --- App ---
# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (optional; checkout is disabled when unset) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google OAuth (optional; only read by the unused src/lib/auth.ts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
